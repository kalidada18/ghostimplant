<!--
  sysmon-ghost.xml — telemetry collection profile for the GHOST lab.

  Purpose: emit the event classes that the techniques in README section 16
  actually touch, without drowning the collector in noise. This is a research
  collection config, not a production one: it is deliberately narrow so that a
  "nothing fired" result during an experiment means the technique produced no
  event, rather than that the filter dropped it.

  Deploy (from an elevated prompt, in the lab VM only):
      wevtutil el | Select-String -Pattern "Microsoft-Windows-Sysmon"   # already installed?
      sysmon64.exe -accepteula -i sysmon-ghost.xml
      sysmon64.exe -c sysmon-ghost.xml          # hot-reload a changed config

  Schema: Sysmon v14/v15 config schema (EventLoaderVersion 4.90). Field names
  below are the ones the Sigma rules in ../sigma/ match on, so keep them in sync
  when changing channels.

  Channel -> events needed by the rules:
    1  Process Create        : scheduled task, PPID spoof, masquerading, wmic/cmd/powershell spawn
    3  Network connect       : HTTPS beacon
    7  Image loaded          : winsqlite3.dll credential access, modules loaded into lsass
    8  CreateRemoteThread    : remote-thread and APC injection
    9  Raw access read       : direct volume access / MBR read (src/disk.cpp)
    10 Process access        : OpenProcess/OpenThread for injection, winlogon token access
    11 File created          : implant drop, staged tool files
    12 Registry object add/delete/set : Run key, Defender Exclusions\Paths
    13 Registry value set    : same, value-level
    19/20/21 WMI             : WMI event-subscription persistence
    22 DNS query             : beacon resolving the C2 host
    23 File delete           : dropper self-deletion

  Tag names follow the Sysmon schema (sysmon64 -s); check_coverage.py validates
  them. "EID 22 is a file download" and "EID 25 is process access" are exactly
  the kind of plausible-looking mapping mistakes that leave a rule unfireable.

  Not covered here because Sysmon cannot see them (see ../README.md "Telemetry
  gaps"): direct syscalls, AMSI/ETW user-mode patching, hardware-breakpoint
  clearing, SetWindowsHookEx(WH_KEYBOARD_LL). Those need an EDR sensor or the
  native ETW providers; a Sysmon rule claiming to catch them would be theatre.
-->
<Sysmon schemaversion="4.90">
  <HashTarget>sha256</HashTarget>
  <CaptureImages>false</CaptureImages>
  <ArchivedLastModifiedTime>true</ArchivedLastModifiedTime>

  <EventFiltering>

    <!-- EID 1: keep everything. In a lab VM the host is single-purpose, and
         filtering process creates is what makes a silent technique look
         absent rather than unrecorded. -->
    <ProcessCreate onmatch="exclude" />

    <!-- EID 3: outbound network. Filter only the noise that would bury the
         beacon (DNS/NTP/SMB chatter from the OS itself). -->
    <NetworkConnect onmatch="exclude">
      <Image condition="is">C:\Windows\System32\svchost.exe</Image>
      <DestinationPort condition="is">53</DestinationPort>
      <DestinationPort condition="is">123</DestinationPort>
      <DestinationPort condition="is">137</DestinationPort>
      <Image condition="contains">C:\Windows\System32\mpcmdrun</Image>
    </NetworkConnect>

    <!-- EID 7: image load. Only the DLLs the credential/evasion paths touch and
         modules that land inside lsass; a full ImageLoad capture is unusable at
         lab volume. Field names are ImageLoaded (the module) and Image (the
         process it loads into) - there is no ImageName/TargetImage on this
         event. -->
    <ImageLoad onmatch="include">
      <ImageLoaded condition="end with">winsqlite3.dll</ImageLoaded>
      <ImageLoaded condition="end with">amsi.dll</ImageLoaded>
      <ImageLoaded condition="end with">etw.dll</ImageLoaded>
      <ImageLoaded condition="end with">urlmon.dll</ImageLoaded>
      <Image condition="is">C:\Windows\System32\lsass.exe</Image>
    </ImageLoad>

    <!-- EID 8: remote thread creation, the primary injection signal. -->
    <CreateRemoteThread onmatch="exclude">
      <SourceImage condition="is">C:\Windows\System32\csrss.exe</SourceImage>
      <SourceImage condition="is">C:\Windows\System32\wininit.exe</SourceImage>
      <SourceImage condition="is">C:\Windows\System32\services.exe</SourceImage>
    </CreateRemoteThread>

    <!-- EID 9: raw volume/disk access. !diskread (src/disk.cpp) opens
         \\.\PhysicalDrive0 to read the MBR, which is the access this event
         class records; the rule filters Microsoft and signed sources. OS
         maintenance reads are excluded here so lab volume stays usable.
         Note there is no raw-WRITE event in Sysmon: the overwrite half of a
         disk wipe emits nothing and is recorded as a gap, not a rule. -->
    <RawAccessRead onmatch="exclude">
      <Image condition="is">C:\Windows\System32\svchost.exe</Image>
      <Image condition="contains">MpCmdRun</Image>
      <Image condition="contains">MsMpEng</Image>
    </RawAccessRead>

    <!-- EID 11: file creation. Broad on purpose: the drop location is what
         identifies the implant, so it must not be pre-filtered. -->
    <FileCreate onmatch="include">
      <TargetFilename condition="contains">WindowsSecurityUpdate</TargetFilename>
      <TargetFilename condition="end with">.exe</TargetFilename>
      <TargetFilename condition="contains">Login Data</TargetFilename>
      <TargetFilename condition="contains">Local State</TargetFilename>
    </FileCreate>

    <!-- EID 12/13: registry. Run keys and Defender exclusions/policy. -->
    <RegistryEvent onmatch="include">
      <TargetObject condition="contains">\CurrentVersion\Run</TargetObject>
      <TargetObject condition="contains">\Windows Defender\Exclusions</TargetObject>
      <TargetObject condition="contains">\CurrentVersion\Once</TargetObject>
      <TargetObject condition="contains">\Services\</TargetObject>
      <!-- Defender tampering disable vector (T1562.001): the policy keys are a
           different hive branch from \Exclusions\, so a rule scoped to the
           exclusion path never sees it. -->
      <TargetObject condition="contains">\Policies\Microsoft\Windows Defender</TargetObject>
      <!-- UAC bypass (T1548.002): the ms-settings Shell\Open\command handler.
           The write is attributed to the implant's Image, which is why the
           rule survives the handler being cleaned up a second later. -->
      <TargetObject condition="contains">\ms-settings\Shell\Open\command</TargetObject>
    </RegistryEvent>

    <!-- EID 18/19/20/21: WMI. The persistence lives in ROOT\subscription. -->
    <WmiEvent onmatch="exclude" />

    <!-- EID 23: file deletion (dropper self-deletion). -->
    <FileDelete onmatch="include">
      <TargetFilename condition="contains">.exe</TargetFilename>
    </FileDelete>

    <!-- EID 22: DNS query. The beacon's host is resolved in-process through
         dnsapi, so the query is attributed to the implant; this is the
         resolution half of the C2 channel, and the rule that matches it needs
         this element. There is no file-download event in Sysmon. -->
    <DnsQuery onmatch="exclude" />

    <!-- EID 10: process access. Injection needs OpenProcess / OpenThread with
         memory-write rights; the masks below are the ones that matter.
         (EID 25 is ProcessTampering - a different event entirely.) -->
    <ProcessAccess onmatch="include">
      <GrantedAccess condition="is">0x1F0FFF</GrantedAccess>
      <GrantedAccess condition="is">0x1FFFFF</GrantedAccess>
      <GrantedAccess condition="is">0x1010</GrantedAccess>
      <GrantedAccess condition="is">0x1F3FFF</GrantedAccess>
      <GrantedAccess condition="is">0x0410</GrantedAccess>
      <GrantedAccess condition="is">0x1F2F</GrantedAccess>
      <GrantedAccess condition="is">0x01F0</GrantedAccess>
      <SourceImage condition="contains">WindowsSecurityUpdate</SourceImage>
      <!-- Token theft (T1134.001): HandleStealToken opens winlogon with
           PROCESS_QUERY_INFORMATION (0x400), which none of the masks above
           cover. The target process is the durable selector here, so any
           access to winlogon is logged and the rule keys on the mask. -->
      <TargetImage condition="end with">winlogon.exe</TargetImage>
      <!-- Credential access (T1003.001): the same argument for lsass — read
           masks like 0x1010/0x1410 are not all in the generic list, and the
           rule keys on (target, mask). -->
      <TargetImage condition="end with">lsass.exe</TargetImage>
    </ProcessAccess>

  </EventFiltering>
</Sysmon>
